<%- include('../partials/bas') %>
<%- include('../partials/kabuk-ust') %>

<% const sz = sozluk; const q = sorgu || {}; %>

<section class="hud">
  <div class="hud-serit">
    <div class="hud-serit-sol">
      <span class="hud-serit-im" aria-hidden="true">≣</span>
      <div>
        <p class="hud-ustbaslik"><%= sz.bicimliSayi(liste.toplam) %> KAYIT</p>
        <h1 class="hud-baslik">ISTIHBARAT KAYITLARI</h1>
      </div>
    </div>
    <div class="hud-serit-sag">
      <a class="cip" href="/arsiv/kayitlar?durum=yeni">BEKLEYENLER</a>
      <a class="cip" href="#yeni-kayit">YENI KAYIT ↓</a>
    </div>
  </div>

  <form method="get" action="/arsiv/kayitlar" class="filtre-cubugu">
    <div class="hud-alan">
      <label for="f-q">ARA</label>
      <input type="search" id="f-q" name="q" value="<%= q.q || '' %>" placeholder="başlık, gövde, kod…">
    </div>
    <div class="hud-alan">
      <label for="f-tur">TUR</label>
      <select id="f-tur" name="tur">
        <option value="">tümü</option>
        <% sabitler.kayitTurleri.forEach(function (t) { %>
          <option value="<%= t %>" <%= q.tur === t ? 'selected' : '' %>><%= sz.KAYIT_TUR_ADI[t] || t %></option>
        <% }); %>
      </select>
    </div>
    <div class="hud-alan">
      <label for="f-durum">DURUM</label>
      <select id="f-durum" name="durum">
        <option value="">tümü</option>
        <% sabitler.kayitDurumlari.forEach(function (d) { %>
          <option value="<%= d %>" <%= q.durum === d ? 'selected' : '' %>><%= sz.DURUM_ADI[d] || d %></option>
        <% }); %>
      </select>
    </div>
    <div class="hud-alan">
      <label for="f-tasnif">TASNIF</label>
      <select id="f-tasnif" name="tasnif">
        <option value="">tümü</option>
        <% sabitler.tasnifler.forEach(function (t) { %>
          <option value="<%= t %>" <%= q.tasnif === t ? 'selected' : '' %>><%= sz.TASNIF_ADI[t] %></option>
        <% }); %>
      </select>
    </div>
    <div class="hud-alan">
      <label for="f-guven">KAYNAK DERECESI</label>
      <select id="f-guven" name="guven">
        <option value="">tümü</option>
        <% sabitler.guvenilirlikler.forEach(function (g) { %>
          <option value="<%= g %>" <%= q.guven === g ? 'selected' : '' %>><%= g %></option>
        <% }); %>
      </select>
    </div>
    <div class="hud-alan">
      <label for="f-vaka">VAKA</label>
      <select id="f-vaka" name="vaka">
        <option value="">tümü</option>
        <% vakalar.forEach(function (v) { %>
          <option value="<%= v.id %>" <%= String(q.vaka) === String(v.id) ? 'selected' : '' %>><%= v.kod %> <%= v.ad %></option>
        <% }); %>
      </select>
    </div>
    <div class="hud-alan">
      <label for="f-kaynak">KAYNAK</label>
      <select id="f-kaynak" name="kaynak">
        <option value="">tümü</option>
        <% kaynaklar.forEach(function (k) { %>
          <option value="<%= k.id %>" <%= String(q.kaynak) === String(k.id) ? 'selected' : '' %>><%= k.ad %></option>
        <% }); %>
      </select>
    </div>
    <div class="hud-alan">
      <label for="f-sirala">SIRALA</label>
      <select id="f-sirala" name="sirala">
        <% [['zaman','olay zamanı'],['yeni','girişe göre'],['guncel','güncellenme'],['tasnif','tasnif'],['guven','güvenilirlik'],['baslik','başlık']].forEach(function (o) { %>
          <option value="<%= o[0] %>" <%= (q.sirala || 'zaman') === o[0] ? 'selected' : '' %>><%= o[1] %></option>
        <% }); %>
      </select>
    </div>
    <div class="hud-alan">
      <label class="gorsel-gizli" for="f-gonder">FILTRELE</label>
      <button type="submit" id="f-gonder" class="dugme dugme--kucuk"><span class="dugme-metin">FILTRELE</span></button>
    </div>
  </form>

  <% if (liste.kayitlar.length) { %>
    <div class="hud-tablo-sarmal">
      <table class="hud-tablo">
        <thead>
          <tr>
            <th class="daralt">KOD</th>
            <th>BASLIK</th>
            <th class="daralt">TUR</th>
            <th class="daralt">TASNIF</th>
            <th class="daralt">DERECE</th>
            <th class="daralt">DURUM</th>
            <th class="sayi daralt">VARLIK</th>
            <th class="daralt">ZAMAN</th>
          </tr>
        </thead>
        <tbody>
          <% liste.kayitlar.forEach(function (k) { %>
            <tr>
              <td class="daralt"><span class="kod"><%= k.kod %></span></td>
              <td>
                <a href="/arsiv/kayit/<%= k.id %>"><%= k.baslik %></a>
                <% if (k.ozet) { %><span class="satir-alt"><%= k.ozet.slice(0, 130) %><%= k.ozet.length > 130 ? '…' : '' %></span><% } %>
                <% if (k.vaka_kod) { %><span class="satir-alt">vaka: <%= k.vaka_kod %> <%= k.vaka_ad %></span><% } %>
              </td>
              <td class="daralt kucuk"><%= sz.KAYIT_TUR_ADI[k.tur] || k.tur %></td>
              <td class="daralt">
                <span class="cip cip-tasnif cip-tasnif--<%= k.tasnif %>"><%= sz.TASNIF_ADI[k.tasnif] %></span>
              </td>
              <td class="daralt">
                <span class="derece derece--<%= String(k.guvenilirlik).toLowerCase() %>"
                      title="<%= sz.GUVENILIRLIK_ADI[k.guvenilirlik] %> / <%= sz.DOGRULUK_ADI[k.dogruluk] %>">
                  <%= k.guvenilirlik %><%= k.dogruluk %>
                </span>
              </td>
              <td class="daralt kucuk">
                <span class="durum-nokta durum-nokta--<%= k.durum %>" aria-hidden="true"></span>
                <%= sz.DURUM_ADI[k.durum] || k.durum %>
              </td>
              <td class="sayi daralt"><%= k.varlik_sayisi %></td>
              <td class="daralt kucuk sonuk"><%= sz.tarihSozcuk(k.zaman, { gunAdi: false }) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <% if (sayfaSayisi > 1) { %>
      <nav class="sayfalama" aria-label="Sayfalama">
        <% const temel = Object.keys(q).filter(function (k) { return k !== 'sayfa' && q[k]; })
             .map(function (k) { return encodeURIComponent(k) + '=' + encodeURIComponent(q[k]); }).join('&'); %>
        <% for (let i = 1; i <= Math.min(sayfaSayisi, 14); i++) { %>
          <% if (i === sayfa) { %><span class="etkin"><%= i %></span>
          <% } else { %><a href="/arsiv/kayitlar?<%= temel ? temel + '&' : '' %>sayfa=<%= i %>"><%= i %></a><% } %>
        <% } %>
        <% if (sayfaSayisi > 14) { %><span>… <%= sayfaSayisi %></span><% } %>
      </nav>
    <% } %>
  <% } else { %>
    <div class="bos-durum">
      <span class="bos-durum-im" aria-hidden="true">≣</span>
      <p>Bu filtreyle eşleşen kayıt yok.</p>
    </div>
  <% } %>
</section>

<!-- ======================================================== YENI KAYIT -->
<section class="hud bosluk-ust" id="yeni-kayit">
  <div class="hud-serit">
    <div class="hud-serit-sol">
      <span class="hud-serit-im" aria-hidden="true">＋</span>
      <h2 class="hud-baslik hud-baslik--kucuk">YENI KAYIT</h2>
    </div>
  </div>

  <form method="post" action="/arsiv/kayit" class="hud-form">
    <%- csrfAlani() %>
    <div class="hud-alan">
      <label for="k-baslik">BASLIK</label>
      <input type="text" id="k-baslik" name="baslik" required maxlength="300">
    </div>
    <div class="hud-alan">
      <label for="k-govde">GOVDE</label>
      <textarea id="k-govde" name="govde" rows="8"
                placeholder="Ham istihbarat metnini olduğu gibi gir. Motor bu metinden özet, anahtar kavram ve varlık çıkarır."></textarea>
    </div>

    <div class="hud-form-izgara">
      <div class="hud-alan">
        <label for="k-tur">TUR</label>
        <select id="k-tur" name="tur">
          <% sabitler.kayitTurleri.forEach(function (t) { %>
            <option value="<%= t %>" <%= t === 'rapor' ? 'selected' : '' %>><%= sz.KAYIT_TUR_ADI[t] || t %></option>
          <% }); %>
        </select>
      </div>
      <div class="hud-alan">
        <label for="k-tasnif">TASNIF</label>
        <select id="k-tasnif" name="tasnif">
          <% sabitler.tasnifler.forEach(function (t) { %>
            <option value="<%= t %>" <%= t === (locals.varsayilanTasnif || 'hizmete_ozel') ? 'selected' : '' %>><%= sz.TASNIF_ADI[t] %></option>
          <% }); %>
        </select>
      </div>
      <div class="hud-alan">
        <label for="k-kaynak">KAYNAK</label>
        <select id="k-kaynak" name="kaynak_id">
          <option value="">— seçilmedi —</option>
          <% kaynaklar.forEach(function (k) { %>
            <option value="<%= k.id %>"><%= k.ad %> (<%= k.guvenilirlik %>)</option>
          <% }); %>
        </select>
      </div>
      <div class="hud-alan">
        <label for="k-guven">KAYNAK DERECESI</label>
        <select id="k-guven" name="guvenilirlik">
          <% sabitler.guvenilirlikler.forEach(function (g) { %>
            <option value="<%= g %>" <%= g === 'C' ? 'selected' : '' %>><%= g %> — <%= sz.GUVENILIRLIK_ADI[g] %></option>
          <% }); %>
        </select>
      </div>
      <div class="hud-alan">
        <label for="k-dogruluk">DOGRULUK</label>
        <select id="k-dogruluk" name="dogruluk">
          <% [1,2,3,4,5,6].forEach(function (d) { %>
            <option value="<%= d %>" <%= d === 3 ? 'selected' : '' %>><%= d %> — <%= sz.DOGRULUK_ADI[d] %></option>
          <% }); %>
        </select>
      </div>
      <div class="hud-alan">
        <label for="k-durum">DURUM</label>
        <select id="k-durum" name="durum">
          <% sabitler.kayitDurumlari.forEach(function (d) { %>
            <option value="<%= d %>" <%= d === 'yeni' ? 'selected' : '' %>><%= sz.DURUM_ADI[d] || d %></option>
          <% }); %>
        </select>
      </div>
      <div class="hud-alan">
        <label for="k-vaka">VAKA</label>
        <select id="k-vaka" name="vaka_id">
          <option value="">— seçilmedi —</option>
          <% vakalar.forEach(function (v) { %>
            <option value="<%= v.id %>"><%= v.kod %> <%= v.ad %></option>
          <% }); %>
        </select>
      </div>
      <div class="hud-alan">
        <label for="k-zaman">OLAY ZAMANI</label>
        <input type="datetime-local" id="k-zaman" name="olay_zamani">
      </div>
      <div class="hud-alan">
        <label for="k-konum">KONUM</label>
        <input type="text" id="k-konum" name="konum" maxlength="200">
      </div>
      <div class="hud-alan">
        <label for="k-enlem">ENLEM</label>
        <input type="text" id="k-enlem" name="enlem">
      </div>
      <div class="hud-alan">
        <label for="k-boylam">BOYLAM</label>
        <input type="text" id="k-boylam" name="boylam">
      </div>
      <div class="hud-alan hud-alan--genis">
        <label for="k-etiket">ETIKETLER</label>
        <input type="text" id="k-etiket" name="etiketler" placeholder="virgülle ayır">
      </div>
    </div>

    <div class="hud-dugmeler">
      <button type="submit" class="dugme"><span class="dugme-metin">KAYDI OLUSTUR</span></button>
    </div>
  </form>
</section>

<%- include('../partials/kabuk-alt') %>
<% const betikler = ['/js/arsiv.js']; %>
<%- include('../partials/son', { betikler: betikler }) %>
<%- const betikler = arsiv.js -%>
<% include("partials/son") -%>
