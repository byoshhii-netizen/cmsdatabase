{
  "name": "cms-veri-merkezi",
  "version": "0.1.0",
  "private": true,
  "description": "CMS Veri Merkezi - sifreli veri kasasi, strateji panosu ve yapay zeka ajani",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:reset": "node src/db/migrate.js --sifirla",
    "db:seed": "node src/db/seed.js",
    "guvenlik:anahtar": "node -e \"console.log('SESSION_SECRET=' + require('crypto').randomBytes(48).toString('hex')); console.log('ENCRYPTION_KEY=' + require('crypto').randomBytes(32).toString('hex'))\""
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "ua-parser-js": "^1.0.39"
  }
}
