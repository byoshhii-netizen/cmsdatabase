# ============================================================
#  CMS VERI MERKEZI - ORTAM DEGISKENLERI
#  Bu dosyayi ".env" olarak kopyalayip degerleri doldurun.
#  .env dosyasi ASLA git deposuna eklenmez.
# ============================================================

# --- Sunucu ---
NODE_ENV=development
PORT=3000

# Railway arkasinda calisirken 1 birakin (X-Forwarded-For guvenilir proxy sayisi)
TRUST_PROXY=1

# Uygulamanin dis dunyaya gorunen adresi (paylasim linkleri icin)
# Ornek: https://cms-veri-merkezi.up.railway.app
PUBLIC_URL=http://localhost:3000

# --- PostgreSQL ---
# Railway'de PostgreSQL eklentisi bu degiskeni otomatik saglar.
DATABASE_URL=postgresql://postgres:sifre@localhost:5432/cms_veri_merkezi
# otomatik | zorunlu | kapali  -> Railway dis baglantida "zorunlu" olmali
DB_SSL=otomatik
DB_POOL_MAX=10

# --- Kriptografi ---
# "npm run guvenlik:anahtar" komutu ile uretin.
# SESSION_SECRET: en az 32 karakter rastgele deger
SESSION_SECRET=
# ENCRYPTION_KEY: API anahtarlarinin AES-256-GCM ile sifrelenmesi icin 64 HEX karakter (32 bayt)
ENCRYPTION_KEY=

# --- Varsayilan yonetici ---
# Ilk migrasyonda olusturulur, veritabaninda argon2id ile hashlenir.
# Giris yaptiktan sonra /ayarlar uzerinden degistirin.
# Ilk migrasyondan once guclu ve benzersiz bir deger belirleyin.
VARSAYILAN_KULLANICI=cms
VARSAYILAN_SIFRE=

# --- Oturum politikasi (dakika) ---
OTURUM_BOSTA_DAKIKA=60
OTURUM_MUTLAK_DAKIKA=720

# --- Brute-force politikasi ---
BF_ESIK=5
BF_KILIT_DAKIKA=5
BF_AGIR_ESIK=10
BF_AGIR_KILIT_DAKIKA=60

# --- Depo ---
DEPO_YOLU=./depo_veri
DEPO_MAX_MB=50

# --- Pano (cizim/strateji tuvali) ---
PANO_RESIM_MAX_MB=6
PANO_YEDEK_MAX_MB=40

# --- Cambaz (yapay zeka ajani) ---
# API anahtarlarini (Anthropic/OpenAI/Gemini/Groq/OpenRouter/Tavily/Serper/
# ElevenLabs) buraya yazmaniza GEREK YOK: /ayarlar ekranindan girilen
# anahtarlar veritabaninda AES-256-GCM ile sifreli saklanir ve kalicidir.
CAMBAZ_SAGLAYICI=anthropic
CAMBAZ_MODEL=claude-sonnet-4-5
CAMBAZ_HTTP_TIMEOUT_MS=30000
CAMBAZ_MAX_GECMIS=20
CAMBAZ_MAX_CIKTI_TOKEN=1024
CAMBAZ_SES_MAX_MB=15
